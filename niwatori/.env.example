# cp .env.example .env して値を埋める。main.py実行前に読み込む場合は
# `export $(grep -v '^#' .env | xargs)` または python-dotenv等を利用すること。

# --- Supabase ---
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_TABLE=sleep_records

# --- 統合レコード送信間隔(秒) ---
AGGREGATION_INTERVAL_SEC=60

# --- A111ミリ波レーダー(呼吸検知) ---
# 実機・配線確定前は true のままでOK(モッククライアントを使用)
RADAR_USE_MOCK=true
# 実機接続後: "spi" | "uart" | "socket"
RADAR_LINK=spi
# RADAR_LINK=uart の場合のみ使用 (例: /dev/ttyUSB0)
RADAR_SERIAL_PORT=
RADAR_SENSOR_ID=1

# --- SPH0645LM4H マイク(鶏本体, I2S) ---
# 未指定ならOS既定の入力デバイスを使用。`python -m sounddevice`で一覧確認可能
MIC_DEVICE=
MIC_SAMPLE_RATE=16000
MIC_BLOCK_SIZE=1024
